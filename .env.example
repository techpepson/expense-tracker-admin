# Base URL of the shared REST API (no trailing slash). Paths like /api/admin/... are appended.
VITE_API_BASE_URL=http://localhost:8000
# "true" serves the API from the in-browser MSW mock (seeded from docs/expenditure.xlsx).
VITE_USE_MOCKS=true
# Public URL of the separate employee app (shown to employees who try to sign in here).
VITE_EMPLOYEE_APP_URL=http://localhost:5173

